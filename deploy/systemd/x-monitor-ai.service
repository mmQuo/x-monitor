[Unit]
Description=AI enrichment for monitored X posts
After=network-online.target x-monitor-monitor.service
Wants=network-online.target

[Service]
Type=simple
User=xmonitorai
Group=xmonitorweb
WorkingDirectory=/srv/x-monitor
EnvironmentFile=/etc/x-monitor-ai.env
ExecStart=/srv/x-monitor/.venv/bin/python /srv/x-monitor/ai_worker.py --interval 5 --batch-size 10
Restart=always
RestartSec=15
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/x-monitor/ai_data
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
