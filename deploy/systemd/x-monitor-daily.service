[Unit]
Description=Generate X monitor daily briefs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xmonitorai
Group=xmonitorweb
WorkingDirectory=/srv/x-monitor
EnvironmentFile=/etc/x-monitor-ai.env
ExecStart=/srv/x-monitor/.venv/bin/python /srv/x-monitor/daily_worker.py --schedule
Restart=always
RestartSec=15
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/x-monitor/report_data
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
