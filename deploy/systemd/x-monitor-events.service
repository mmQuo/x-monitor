[Unit]
Description=Extract new facts and maintain live news events
After=network-online.target x-monitor-clean.service
Wants=network-online.target x-monitor-clean.service

[Service]
Type=simple
User=xmonitorai
Group=xmonitorweb
WorkingDirectory=/srv/x-monitor
EnvironmentFile=/etc/x-monitor-ai.env
ExecStart=/srv/x-monitor/.venv/bin/python /srv/x-monitor/event_worker.py --interval 15
Restart=always
RestartSec=15
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/x-monitor/event_data /srv/x-monitor/clean_data
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
